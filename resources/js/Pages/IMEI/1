<script setup>
import { Head, router } from '@inertiajs/vue3';
import AdminLayout from '@/Layouts/AdminLayout.vue';
import { ArrowDownTrayIcon, ArrowPathIcon } from '@heroicons/vue/24/outline';

const props = defineProps({
    registrations: {
        type: Array,
        default: () => []
    }
});

// Handler untuk mengirim request perubahan status secara realtime ke backend Laravel
const updateStatus = (id, newStatus) => {
    router.put(route('admin.imei.update-status', id), {
        status: newStatus
    }, {
        preserveScroll: true,
    });
};

// Helper pemberi warna status badge pendaftaran yang sinkron dengan database
const getStatusBadge = (status) => {
    switch (status) {
        case 'selesai':
            return 'bg-emerald-500/10 text-emerald-500 ring-emerald-500/20';
        case 'proses':
            return 'bg-blue-500/10 text-blue-500 ring-blue-500/20';
        case 'pending':
            return 'bg-amber-500/10 text-amber-500 ring-amber-500/20';
        case 'ditolak':
            return 'bg-red-500/10 text-red-500 ring-red-500/20';
        default:
            return 'bg-slate-500/10 text-slate-400 ring-slate-500/20';
    }
};
</script>

<template>
    <AdminLayout>
        <Head title="Antrean Registrasi IMEI" />

        <div class="space-y-6">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                    <h2 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Antrean Pengajuan IMEI</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Kelola, verifikasi, dan pantau seluruh data permohonan jaringan perangkat pelanggan.</p>
                </div>
                <button @click="() => router.reload()" class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-all shadow-sm">
                    <ArrowPathIcon class="w-4 h-4" /> Segarkan Data
                </button>
            </div>

            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 dark:bg-slate-900/50 border-b border-slate-200 dark:border-slate-800 text-[11px] font-bold uppercase tracking-wider text-slate-400">
                                <th class="px-6 py-4">No. Registrasi</th>
                                <th class="px-6 py-4">Nama Pelanggan</th>
                                <th class="px-6 py-4">Tipe SIM</th>
                                <th class="px-6 py-4">Nomor IMEI</th>
                                <th class="px-6 py-4">Tanggal Pengajuan</th>
                                <th class="px-6 py-4 text-center">Status</th>
                                <th class="px-6 py-4 text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-xs font-medium text-slate-700 dark:text-slate-300">
                            <tr v-if="props.registrations.length === 0">
                                <td colspan="7" class="px-6 py-10 text-center text-slate-400 dark:text-slate-500 font-bold">
                                    Belum ada data antrean pendaftaran IMEI saat ini.
                                </td>
                            </tr>
                            <tr v-for="item in props.registrations" :key="item.id" class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                                <td class="px-6 py-4 font-bold text-blue-600 dark:text-blue-400">
                                    #{{ item.registration_number }}
                                </td>

                                <td class="px-6 py-4">
                                    <div class="font-bold text-slate-900 dark:text-white">{{ item.user?.name ?? 'Unknown' }}</div>
                                    <div class="text-[10px] text-slate-400">{{ item.user?.whatsapp_number }}</div>
                                </td>

                                <td class="px-6 py-4">
                                    <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-bold text-[10px] uppercase">
                                        {{ item.sim_type }} SIM
                                    </span>
                                </td>

                                <td class="px-6 py-4 space-y-0.5 font-mono text-[11px]">
                                    <div><span class="text-slate-400">1:</span> {{ item.imei1 }}</div>
                                    <div v-if="item.imei2"><span class="text-slate-400">2:</span> {{ item.imei2 }}</div>
                                </td>

                                <td class="px-6 py-4 text-slate-400">
                                    {{ new Date(item.created_at).toLocaleDateString('id-ID', {day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'}) }} WIB
                                </td>

                                <td class="px-6 py-4 text-center">
                                    <span :class="getStatusBadge(item.status)" class="inline-flex items-center rounded-md px-2 py-1 text-xs font-bold ring-1 ring-inset uppercase">
                                        {{ item.status }}
                                    </span>
                                </td>

                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <select :value="item.status" @change="updateStatus(item.id, $event.target.value)" class="text-[11px] bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded px-2 py-1 font-bold text-slate-700 dark:text-slate-200 shadow-sm focus:ring-0 focus:border-slate-400 transition-all">
                                            <option value="pending">⏳ Pending</option>
                                            <option value="proses">🔄 Proses</option>
                                            <option value="selesai">✅ Selesai</option>
                                            <option value="ditolak">❌ Ditolak</option>
                                        </select>

                                        <a v-if="item.status === 'selesai'" :href="route('imei.download-pdf', item.id)" class="inline-flex items-center gap-1 px-2.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-[11px] font-bold transition-all shadow-sm">
                                            <ArrowDownTrayIcon class="w-3.5 h-3.5" /> Cetak PDF
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </AdminLayout>
</template>